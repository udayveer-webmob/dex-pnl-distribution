# Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://pnl:pnl@localhost:5433/pnl?schema=public"

# Alchemy Ethereum mainnet RPC (needs archive access for historical reads)
ALCHEMY_API_KEY=""

# CoinGecko: plan is "demo" or "pro" (selects base URL and auth header)
COINGECKO_API_KEY=""
COINGECKO_PLAN="demo"

# Worker polling interval in seconds
POLL_INTERVAL_SECONDS=120
